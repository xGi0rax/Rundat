GARMIN_EMAIL=runner@example.com
GARMIN_PASSWORD=change-me
RUNDAT_ACCESS_TOKEN=generate-a-long-random-value

# In produzione usare la connection string "Transaction pooler" di Supabase.
# DATABASE_URL=postgresql://postgres.project-ref:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# DATABASE_SSLMODE=require

# Percorsi assoluti opzionali:
# RUNDAT_DB_PATH=C:\data\rundat.db

# Origini separate da virgola; usato solo quando frontend e API hanno origini diverse.
# RUNDAT_CORS_ORIGINS=https://rundat.example.com
