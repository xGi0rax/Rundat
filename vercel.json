{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "fluid": true,
  "regions": ["fra1"],
  "installCommand": "python -m pip install --break-system-packages --disable-pip-version-check -r requirements.txt && npm --prefix frontend install --include=dev --no-audit --no-fund",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{frontend/**,backend/tests/**,scripts/**,supabase/**,**/*.csv,**/*.db,**/__pycache__/**}"
    }
  }
}
